DJANGO_SECRET_KEY=troque-por-uma-chave-secreta
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em production, informe as origens completas e HTTPS, separadas por virgula.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production usa True por padrao. Mantenha False no desenvolvimento HTTP local.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# Ative HSTS gradualmente somente depois que todo o dominio estiver em HTTPS.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Ative apenas atras de um proxy confiavel que substitua X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_LOG_LEVEL=INFO
# Opcional: destino do collectstatic. O padrao local e staticfiles/.
# DJANGO_STATIC_ROOT=C:\caminho\temporario\staticfiles

# PostgreSQL
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=financeiro_db
DATABASE_USER=financeiro_user
DATABASE_PASSWORD=troque-por-uma-senha-local
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
# Banco exclusivo para testes. Nunca use o mesmo valor de DATABASE_NAME.
TEST_DATABASE_NAME=financeiro_test

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=seu-client-secret

# Alternativa SQLite: use django.db.backends.sqlite3 e db.sqlite3 nos campos
# DATABASE_ENGINE e DATABASE_NAME; os demais campos nao serao necessarios.
